@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap');
:root{--ink:#0D2436;--marine:#163A52;--marine-2:#1E4A66;--foam:#EDEFEA;--card:#FBFAF7;--brass:#C0873E;--brass-dark:#9C6C2B;--text:#12222B;--muted:#5E7481;--line:#D8DCD3;--good:#3E7A5C;--danger:#A5432E;--radius:4px}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--foam);color:var(--text);font:400 15px/1.5 'IBM Plex Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0}
h1,h2,.serif,.brand-word{font-family:'Fraunces',Georgia,serif}
a{color:inherit}
button,input,select{font-family:inherit;font-size:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--brass);outline-offset:1px}
.wrap{max-width:1120px;margin:0 auto;padding:0 28px}
.mut{color:var(--muted)}

/* header + footer */
.site-header{background:var(--ink);color:#F4F4F0}
.site-header .wrap{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 20px;min-height:68px;padding-top:8px;padding-bottom:8px}
.wordmark{display:flex;align-items:center;gap:10px;text-decoration:none;color:#F4F4F0}
.wordmark svg{width:22px;height:22px}
.brand-word{font-size:20px;font-weight:600;letter-spacing:.02em}
.site-nav{display:flex;gap:28px;font-size:14px}
.site-nav a{text-decoration:none;color:#C9D2D6;padding-bottom:3px;border-bottom:1px solid transparent;transition:color .15s,border-color .15s}
.site-nav a:hover,.site-nav a.current{color:#F4F4F0;border-color:var(--brass)}
@media(max-width:560px){.site-nav{gap:16px;font-size:13px}}
.site-footer{background:var(--ink);color:#8FA0AA;font-size:12.5px;padding:22px 0;margin-top:auto}
.site-footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
.site-footer a{color:#C9D2D6;text-decoration:none;margin-left:16px}
body{display:flex;flex-direction:column;min-height:100vh}

/* hero */
.hero{position:relative;background:linear-gradient(180deg,var(--ink),var(--marine));color:#F4F4F0;overflow:hidden;padding:64px 0 140px}
.hero .lines{position:absolute;inset:0;opacity:.5;pointer-events:none}
.hero .lines svg{width:100%;height:100%}
.hero-inner{position:relative;max-width:560px}
.hero h1{font-size:clamp(32px,4.8vw,48px);line-height:1.12;font-weight:600;margin:0 0 16px}
.hero p{color:#C9D2D6;margin:0;max-width:46ch}
.overlap{position:relative;margin-top:-96px;padding-bottom:48px}

/* cards, panels, forms */
.card{background:var(--card);border-radius:var(--radius);box-shadow:0 24px 48px -20px rgba(13,36,54,.45);overflow:hidden}
.card-head{background:var(--ink);color:#F4F4F0;padding:18px 32px;font-weight:600}
.card-body{padding:32px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px;margin-bottom:18px}
.panel h2,.panel h3{font-size:18px;margin-bottom:4px}
.sub{color:var(--muted);font-size:13.5px;margin:0 0 20px}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:500}
.field input,.field select{width:100%;border:1px solid var(--line);border-radius:var(--radius);padding:11px 12px;color:var(--text);background:#fff}
.field.bad input,.field.bad select{border-color:var(--danger)}
.err{display:none;font-size:11.5px;color:var(--danger);margin-top:5px}
.field.bad .err{display:block}
.grid2,.grid3{display:grid;gap:16px;margin-bottom:18px}
.grid2{grid-template-columns:1fr 1fr}
.grid3{grid-template-columns:repeat(3,1fr)}
@media(max-width:640px){.grid2,.grid3{grid-template-columns:1fr}.card-body{padding:24px 20px}}
.alert{display:none;margin-top:14px;font-size:13px;border-radius:var(--radius);padding:10px 14px}
.alert.show{display:block}
.alert.error{color:var(--danger);background:#FBEAE5;border:1px solid #EFC5B8}
.alert.info{color:var(--marine-2);background:#F3F0E6;border:1px solid var(--line)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:var(--radius);padding:12px 20px;font-weight:600;text-decoration:none;transition:background .15s,border-color .15s}
.btn svg{width:16px;height:16px}
.btn-primary{background:var(--brass);color:var(--ink)}
.btn-primary:hover{background:var(--brass-dark);color:#F4F4F0}
.btn-ghost{background:#fff;border-color:var(--line);color:var(--marine-2)}
.btn-ghost:hover{border-color:var(--brass)}
.btn-danger{background:var(--danger);color:#fff}
.btn-block{width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}
.linkbtn{background:none;border:0;padding:0;font-weight:600;color:var(--brass-dark);border-bottom:1px solid var(--brass-dark);align-self:flex-start;font-size:13px}
.stepper{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:var(--radius);padding:6px 8px;background:#fff}
.stepper button{width:28px;height:28px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--marine-2)}
.stepper button:hover{border-color:var(--brass)}
.toggle{position:relative;width:42px;height:24px;border-radius:12px;background:var(--line);border:0;flex-shrink:0}
.toggle::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .15s}
.toggle.on{background:var(--brass)}
.toggle.on::after{left:20px}

/* progress, summary bar */
.progress{background:var(--marine);color:#F4F4F0}
.steps{display:flex;align-items:center;padding:16px 28px;max-width:1120px;margin:0 auto}
.step{display:flex;align-items:center;gap:8px;font-size:13px;color:#93A5AE;white-space:nowrap}
.step .n{width:20px;height:20px;border-radius:50%;border:1px solid #4E6B7B;display:flex;align-items:center;justify-content:center;font-size:11px}
.step.done{color:#F4F4F0}
.step.done .n{background:var(--brass);border-color:var(--brass);color:var(--ink);font-weight:700}
.step.active{color:#F4F4F0;font-weight:600}
.step.active .n{border-color:var(--brass)}
.step-sep{flex:1;height:1px;background:#3A5164;margin:0 12px;min-width:16px}
@media(max-width:700px){.step .l{display:none}.step.active .l{display:inline}.step-sep{margin:0 6px}}
.summary{background:var(--ink);color:#F4F4F0;border-top:1px solid #1D3A4D}
.summary .wrap{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:16px;padding-bottom:16px}
.summary .route{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:600}
.summary svg{width:15px;height:15px;stroke:#C9D2D6}
.summary .meta{font-size:12.5px;color:#B9CAD1}
.link{font-size:13px;font-weight:600;color:#F4F4F0;text-decoration:none;border-bottom:1px solid var(--brass);padding-bottom:2px;white-space:nowrap}

/* layout + sidebar */
.layout{display:grid;grid-template-columns:1fr 310px;gap:26px;padding:28px 0 60px;align-items:start}
.sticky{position:sticky;top:20px}
@media(max-width:900px){.layout{grid-template-columns:1fr}.sticky{position:static}}
.side{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
.side h2{font-size:16px;margin-bottom:14px}
.row{display:flex;justify-content:space-between;gap:12px;font-size:13.5px;color:var(--muted);margin-bottom:10px}
.row b{color:var(--text);font-weight:500}
.total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line);margin-top:12px;padding-top:14px;font-weight:600}
.total .amt{font-size:22px;font-family:'Fraunces',serif}
.note{font-size:11.5px;color:var(--muted);margin-top:10px;line-height:1.5}

/* itinerary legs */
.leg{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--line)}
.leg:last-child{padding-bottom:0;margin-bottom:0;border:0}
.leg .lab{font-size:11.5px;font-weight:600;color:var(--brass-dark);margin-bottom:8px;letter-spacing:.03em}
.times{display:flex;align-items:center;gap:18px}
.tb{text-align:center}
.tb .t{font:600 20px 'Fraunces',serif}
.tb .t sup{font-size:11px;font-family:'IBM Plex Sans',sans-serif;color:var(--muted)}
.tb .c{font-size:12px;color:var(--muted)}
.path{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:110px;flex:0 1 150px}
.path .d{font-size:12px;color:var(--muted)}
.path .ln{width:100%;height:1px;background:var(--line);position:relative}
.path .ln::after{content:"";position:absolute;right:0;top:50%;width:6px;height:6px;border-radius:50%;background:var(--marine-2);transform:translateY(-50%)}
.path .s{font-size:11.5px;color:var(--muted)}
.path .s.direct{color:var(--good)}
.leg .meta{text-align:right;font-size:12.5px;color:var(--muted);line-height:1.6}
.leg .meta b{color:var(--text)}
@media(max-width:640px){.leg{grid-template-columns:1fr}.leg .meta{text-align:left}.times{flex-wrap:wrap}}

/* misc shared */
.pill{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--good);background:#E5F0E9;border-radius:20px;padding:6px 12px}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.bad{color:var(--danger);background:#FBEAE5}
.perf{position:relative;height:1px;margin:26px -32px 22px;background:radial-gradient(circle,var(--line) 1.5px,transparent 1.5px) center/10px 1px repeat-x}
.perf::before,.perf::after{content:"";position:absolute;top:-11px;width:22px;height:22px;border-radius:50%;background:var(--foam)}
.perf::before{left:-11px}
.perf::after{right:-11px}
.info{border-top:1px solid var(--line);padding:40px 0 48px;display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.info div{display:flex;gap:14px}
.info svg{width:26px;height:26px;flex-shrink:0;stroke:var(--marine-2);margin-top:2px}
.info h3{font:600 14.5px 'IBM Plex Sans',sans-serif;margin-bottom:4px}
.info p{margin:0;font-size:13.5px;color:var(--muted)}
@media(max-width:760px){.info{grid-template-columns:1fr}}
.modal-bg{position:fixed;inset:0;background:rgba(13,36,54,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
.modal-bg.show{display:flex}
.modal{background:var(--card);border-radius:var(--radius);max-width:440px;width:100%;max-height:90vh;overflow:auto;padding:26px;box-shadow:0 30px 60px -20px rgba(13,36,54,.6)}
.modal h3{font:600 20px 'Fraunces',serif;margin-bottom:10px}
.modal p{color:var(--muted);font-size:13.5px;margin:0 0 18px}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:var(--ink);color:#F4F4F0;font-size:13.5px;font-weight:500;padding:12px 20px;border-radius:var(--radius);box-shadow:0 18px 36px -16px rgba(13,36,54,.6);z-index:60}
@media print{.site-header,.site-footer,.progress,.no-print,.hero{display:none!important}body{background:#fff}.card{box-shadow:none;border:1px solid var(--line)}.overlap{margin-top:0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
